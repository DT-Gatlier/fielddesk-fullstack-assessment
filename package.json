{
  "name": "fielddesk-fullstack-assessment",
  "version": "1.0.0",
  "description": "This practical assessment is conducted by **Gatlier** to evaluate full-stack engineering ability, with particular emphasis on backend correctness, security, database design, testing and production awareness.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "tsx watch api/src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "dev:worker": "tsx watch api/src/worker.ts",
    "build": "tsc && npm --prefix web run build",
    "start": "node dist/api/src/server.js",
    "worker": "node dist/api/src/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/*.test.cjs",
    "lint": "tsc --noEmit && npm --prefix web run typecheck",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DT-Gatlier/fielddesk-fullstack-assessment.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DT-Gatlier/fielddesk-fullstack-assessment/issues"
  },
  "homepage": "https://github.com/DT-Gatlier/fielddesk-fullstack-assessment#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
