{
  "name": "fielddesk",
  "private": true,
  "description": "FieldDesk full-stack assessment — Gatlier",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "migrate": "npm run migrate --prefix backend",
    "seed": "npm run seed --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "worker:dev": "npm run dev --prefix worker",
    "frontend:dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "test": "echo \"Tests will be added in Phase 12\" && exit 0",
    "lint": "echo \"Lint will be configured later\" && exit 0"
  },
  "engines": {
    "node": ">=20"
  }
}
