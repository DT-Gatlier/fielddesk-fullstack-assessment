# Application Environment Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
FRONTEND_PORT=3001

# Security & Tokens
JWT_SECRET=fielddesk_super_secret_jwt_key_32_bytes_min_length_for_hmac_sha256!
JWT_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_DAYS=7

# Rate Limiting
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECS=300
EVENT_RATE_LIMIT_MAX=60
EVENT_RATE_LIMIT_WINDOW_SECS=60

# Database (PostgreSQL)
POSTGRES_USER=fielddesk
POSTGRES_PASSWORD=fielddesk123
POSTGRES_DB=fielddesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fielddesk:fielddesk123@localhost:5432/fielddesk

# Redis & Worker Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
QUEUE_NAME=technician-notifications
NOTIFICATION_SIMULATION_MODE=always_success
ENABLE_EMBEDDED_WORKER=true

# Storage & Quotas
DEFAULT_STORAGE_QUOTA_BYTES=524288000
UPLOAD_DIR=./uploads
