# FieldDesk configuration. Copy to .env for local (non-Docker) development:
#   cp .env.example .env
# Every value below is a local development placeholder, not a real secret.
# docker-compose.yml supplies its own container-network values.

NODE_ENV=development
LOG_LEVEL=info
PORT=4000

# PostgreSQL / Redis (local defaults match docker-compose port mappings;
# compose publishes PostgreSQL on 55432 to avoid clashing with a local install)
DATABASE_URL=postgres://fielddesk:fielddesk_dev_password@localhost:55432/fielddesk
REDIS_URL=redis://localhost:6379

# Set true when running behind a reverse proxy (needed for correct client IPs in rate limiting)
TRUST_PROXY=false

# Sessions. Set COOKIE_SECURE=true whenever the app is served over HTTPS.
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# Attachments (bytes). Local disk storage directory is never exposed via the API.
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
DEFAULT_ORG_STORAGE_LIMIT_BYTES=52428800

# Rate limits
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_EVENTS_MAX=120
RATE_LIMIT_EVENTS_WINDOW_SEC=60

# Worker / notifications
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BACKOFF_BASE_MS=1000
NOTIFY_PROVIDER_TIMEOUT_MS=5000
OUTBOX_POLL_MS=1000
WORKER_CONCURRENCY=5

# Mock notification provider: success | temporary_failure | permanent_failure | flaky
# Can also be changed at runtime: npm run mock-provider -- mode <mode>
MOCK_PROVIDER_MODE=success
MOCK_PROVIDER_FLAKY_FAILURES=2
MOCK_PROVIDER_LATENCY_MS=100

# Demo password used by the seed script (development only)
SEED_PASSWORD=Password123!
