# Copy to .env and adjust. Every value here is a local-development placeholder, not a real secret.

NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=3000
# Origin of the frontend, used for CORS and cookie settings.
WEB_ORIGIN=http://localhost:5173

# PostgreSQL superuser used by the container image and the migration/seed scripts (table owner).
POSTGRES_USER=fielddesk_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=fielddesk
# Unprivileged role used by the API and worker at runtime. Row-level security applies to it.
APP_DB_USER=fielddesk_app
APP_DB_PASSWORD=change-me-app

# Host port for the Compose Postgres (5433 avoids clashing with a locally installed Postgres).
POSTGRES_HOST_PORT=5433

# Connection strings as seen from the host. Compose overrides these with the internal hostnames.
DATABASE_URL=postgres://fielddesk_app:change-me-app@localhost:5433/fielddesk
MIGRATION_DATABASE_URL=postgres://fielddesk_owner:change-me-owner@localhost:5433/fielddesk
TEST_DATABASE_URL=postgres://fielddesk_app:change-me-app@localhost:5433/fielddesk_test
TEST_MIGRATION_DATABASE_URL=postgres://fielddesk_owner:change-me-owner@localhost:5433/fielddesk_test

REDIS_URL=redis://localhost:6379

# Sessions
SESSION_TTL_HOURS=12
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Set to true only when the API is reachable exclusively through a reverse proxy (Compose sets it).
TRUST_PROXY=false

# Rate limits (requests per window)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=1 minute

# Password for every seeded sample account (assessment-only).
SEED_PASSWORD=FieldDesk!2026
