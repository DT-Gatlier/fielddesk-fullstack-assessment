NODE_ENV=development
PORT=8000
DATABASE_URL=postgres://fielddesk:fielddesk@localhost:5432/fielddesk
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
DEFAULT_ORG_STORAGE_LIMIT_BYTES=104857600
CACHE_TTL_SECONDS=30
NOTIFICATION_QUEUE_NAME=fielddesk-notifications
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=1000
OUTBOX_POLL_MS=1000
MOCK_NOTIFICATION_MODE=success
LOG_LEVEL=info
