# Database
DATABASE_URL=postgresql://fielddesk:fielddesk@localhost:5432/fielddesk

# Redis
REDIS_URL=redis://localhost:6379

# Auth (use a strong random value in production)
JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=8h

# API
API_PORT=3001
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# Attachments
ATTACHMENTS_DIR=./data/attachments
MAX_ATTACHMENT_BYTES=10485760
DEFAULT_ORG_STORAGE_LIMIT_BYTES=104857600

# Notifications
NOTIFICATION_MOCK_MODE=success

# Migrations (path relative to backend/ when running locally)
MIGRATIONS_DIR=../database/migrations

# Seed
SEED_PASSWORD=FieldDesk2026!
