# Database
POSTGRES_USER=fielddesk
POSTGRES_PASSWORD=fielddesk_dev
POSTGRES_DB=fielddesk
DATABASE_URL=postgresql://fielddesk:fielddesk_dev@postgres:5432/fielddesk

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
ORG_STORAGE_LIMIT_MB=500

# Worker
NOTIFICATION_PROVIDER_FAILURE_RATE=0.3
NOTIFICATION_PROVIDER_PERMANENT_FAILURE_RATE=0.1

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
