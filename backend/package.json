{
  "name": "@fielddesk/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "FieldDesk REST API & Real-time Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec tsx src/server.ts",
    "dev:tsx": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit backend/src",
    "test:isolation": "vitest run tests/isolation",
    "test:concurrency:all": "vitest run tests/concurrency",
    "test:auth": "vitest run ../tests/isolation/auth-and-tenant.test.ts",
    "test:concurrency": "vitest run ../tests/concurrency/scheduling-concurrency.test.ts",
    "test:events": "vitest run ../tests/concurrency/event-idempotency.test.ts",
    "test:attachments": "vitest run ../tests/isolation/attachment-quota.test.ts",
    "test:worker": "vitest run ../tests/isolation/worker-retry.test.ts",
    "test:realtime": "vitest run ../tests/isolation/realtime-isolation.test.ts",
    "test:audit": "vitest run ../tests/isolation/audit-history.test.ts",
    "test:reporting": "vitest run ../tests/isolation/csv-export.test.ts",
    "start:worker": "node dist/workers/index.js",
    "dev:worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@types/multer": "^2.3.0",
    "@types/pg-query-stream": "^1.0.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.7.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.12.0",
    "pg-query-stream": "^4.17.1",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "ioredis-mock": "^8.9.0",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.4",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0"
  }
}
