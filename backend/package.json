{
  "name": "@fielddesk/backend",
  "version": "1.0.0",
  "type": "module",
  "description": "FieldDesk REST API & Real-time Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec tsx src/server.ts",
    "dev:tsx": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:auth": "vitest run ../tests/isolation/auth-and-tenant.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "ioredis-mock": "^8.9.0",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.4",
    "supertest": "^7.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0"
  }
}
