// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist]
}

model Organisation {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  storageLimitBytes BigInt
  createdAt         DateTime @default(now())

  users          User[]
  workOrders     WorkOrder[]
  storageUsage   StorageUsage?
  attachments    Attachment[]
  progressEvents ProgressEvent[]
  auditLogs      AuditLog[]
  notificationJobs NotificationJob[]

  @@map("organisations")
}

model StorageUsage {
  orgId     String       @id @db.Uuid
  usedBytes BigInt       @default(0)
  org       Organisation @relation(fields: [orgId], references: [id])

  @@map("storage_usage")
}

enum Role {
  OWNER
  DISPATCHER
  TECHNICIAN
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  email        String       @unique
  passwordHash String
  role         Role
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  org              Organisation    @relation(fields: [orgId], references: [id])
  createdOrders    WorkOrder[]     @relation("OrderCreator")
  assignedOrders   WorkOrder[]     @relation("OrderAssignee")
  progressEvents   ProgressEvent[]
  auditLogs        AuditLog[]      @relation("AuditActor")
  attachments      Attachment[]

  @@map("users")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Status {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id                   String    @id @default(uuid()) @db.Uuid
  orgId                String    @db.Uuid
  referenceNumber      String
  title                String
  description          String
  priority             Priority  @default(MEDIUM)
  status               Status    @default(OPEN)
  assignedTechnicianId String?   @db.Uuid
  scheduledStart       DateTime? @db.Timestamptz
  scheduledEnd         DateTime? @db.Timestamptz
  siteName             String
  createdBy            String    @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org                Organisation      @relation(fields: [orgId], references: [id])
  creator            User              @relation("OrderCreator", fields: [createdBy], references: [id])
  assignedTechnician User?             @relation("OrderAssignee", fields: [assignedTechnicianId], references: [id])
  attachments        Attachment[]
  progressEvents     ProgressEvent[]
  notificationJobs   NotificationJob[]

  @@unique([orgId, referenceNumber])
  @@index([orgId, status])
  @@map("work_orders")
}

model Attachment {
  id               String   @id @default(uuid()) @db.Uuid
  workOrderId      String   @db.Uuid
  orgId            String   @db.Uuid
  originalFilename String
  storageKey       String   @unique
  mimeType         String
  sizeBytes        BigInt
  uploadedBy       String   @db.Uuid
  createdAt        DateTime @default(now())

  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  org       Organisation @relation(fields: [orgId], references: [id])
  uploader  User         @relation(fields: [uploadedBy], references: [id])

  @@index([workOrderId])
  @@map("attachments")
}

enum EventType {
  STATUS_CHANGED
  NOTE_ADDED
  ATTACHMENT_ADDED
}

model ProgressEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique
  workOrderId String    @db.Uuid
  orgId       String    @db.Uuid
  type        EventType
  occurredAt  DateTime  @db.Timestamptz
  payload     Json
  submittedBy String    @db.Uuid
  createdAt   DateTime  @default(now())

  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  org       Organisation @relation(fields: [orgId], references: [id])
  submitter User         @relation(fields: [submittedBy], references: [id])

  @@map("progress_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String   @db.Uuid
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  org   Organisation @relation(fields: [orgId], references: [id])
  actor User?        @relation("AuditActor", fields: [actorId], references: [id])

  @@index([orgId, targetType, targetId])
  @@map("audit_logs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model NotificationJob {
  id            String    @id @default(uuid()) @db.Uuid
  workOrderId   String    @db.Uuid
  technicianId  String    @db.Uuid
  orgId         String    @db.Uuid
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  lastError     String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  workOrder WorkOrder    @relation(fields: [workOrderId], references: [id])
  org       Organisation @relation(fields: [orgId], references: [id])

  @@map("notification_jobs")
}
